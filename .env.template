# Copy this file to .env, fill the selected provider key and model, then export it:
# set -a; source .env; set +a
# Demo commands read exported environment variables, not this file automatically.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Select a model available in your provider account.
MODEL_PROVIDER=anthropic
